# Archivo de configuración para scripts VPN
# Copiar a .env en el directorio raíz si es necesario

# ============================================
# Backend Configuration
# ============================================

# Puerto del servidor backend
PORT=3001

# Entorno (development, production, test)
NODE_ENV=development

# Nivel de logging (debug, info, warn, error)
LOG_LEVEL=info

# ============================================
# Frontend Configuration
# ============================================

# Puerto del servidor Vite (frontend)
VITE_PORT=3000

# URL de la API del backend
VITE_API_URL=http://localhost:3001/api

# ============================================
# Monitor Configuration
# ============================================

# Intervalo de actualización del monitor (segundos)
REFRESH_INTERVAL=5

# Interfaz WireGuard a monitorear
VPN_INTERFACE=wg0

# ============================================
# Database Configuration
# ============================================

# Ubicación de la base de datos
DB_PATH=./database/vpn.db

# ============================================
# Logging Configuration
# ============================================

# Directorio de logs
LOG_DIR=../logs

# Retención de logs (días)
LOG_RETENTION_DAYS=30

# ============================================
# Sistema
# ============================================

# Usar tmux para sesiones persistentes (true/false)
USE_TMUX=true

# Máximo número de intentos de reconexión
MAX_RETRIES=3

# Timeout para health checks (segundos)
HEALTH_CHECK_TIMEOUT=5
